<file path="src/main/resources/static/index.html">
<!DOCTYPE html>
<html lang="fa" dir="rtl" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>سامانه جامع مدیریت درمانگاه | Enterprise Clinic Suite v3.0</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>

<div id="toast-container" role="status" aria-live="polite" aria-atomic="true"></div>

<!-- ==================== پنجره رسمی ورود به سامانه ==================== -->
<div id="auth-overlay">
    <div class="auth-card">
        <div class="auth-logo">✚</div>
        <div class="auth-title">سامانه هوشمند مدیریت درمانگاه</div>
        <div class="auth-subtitle">پلتفرم یکپارچه بالینی، مالی و حسابرسی رمزنگاری‌شده (Enterprise v3.0)</div>

        <div id="auth-error-box" class="auth-error" role="alert"></div>

        <form id="auth-login-form" onsubmit="event.preventDefault(); submitLogin();">
            <div class="form-group" style="margin-bottom: 16px;">
                <label for="login-user">نام کاربری سازمانی</label>
                <input type="text" id="login-user" autocomplete="username" required maxlength="64" placeholder="نام کاربری خود را وارد کنید...">
            </div>
            <div class="form-group" style="margin-bottom: 24px;">
                <label for="login-pass">رمز عبور</label>
                <input type="password" id="login-pass" autocomplete="current-password" required maxlength="128" placeholder="رمز عبور خود را وارد کنید...">
            </div>
            <button type="submit" class="action-btn" style="width: 100%; padding: 13px; font-size: 0.95rem;">
                🔐 ورود امن به سامانه
            </button>
        </form>

        <div style="margin-top: 22px; padding-top: 14px; border-top: 1px solid var(--glass-border); display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-muted);">
            <span>🛡️ محافظت‌شده با RBAC و Rate-Limiting</span>
            <span style="font-family: monospace;">HMAC-SHA256</span>
        </div>
    </div>
</div>

<!-- ==================== مدال چاپ فاکتور رسمی ==================== -->
<div id="receipt-modal" class="modal-backdrop">
    <div class="modal-card">
        <div class="modal-header">
            <h3>🧾 صورتحساب و رسید رسمی درمانگاه</h3>
