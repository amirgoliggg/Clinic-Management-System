    <!-- ==================== داک شیشه‌ای ترمینال رخدادهای زنده ==================== -->
    <section class="telemetry-dock">
        <div class="telemetry-header">
            <div class="telemetry-title-group">
                <div class="mac-dots">
                    <span class="mac-dot red"></span>
                    <span class="mac-dot yellow"></span>
                    <span class="mac-dot green"></span>
                </div>
                <span>ترمینال زنده رخدادهای هسته | Live Kernel Telemetry</span>
            </div>
            <button type="button" class="telemetry-clear-btn" onclick="clearConsoleLog()">پاکسازی گزارش ✕</button>
        </div>
        <div id="console-log"></div>
    </section>
</main>

<script src="/app.js"></script>
</body>
</html>
