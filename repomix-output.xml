<file path="src/main/resources/static/styles.css">
@import url('https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css');

:root[data-theme="dark"] {
    /* پس‌زمینه عمیق فضایی برای ایجاد بیشترین کنتراست با متن سفید */
    --bg-base: #030712;
    --bg-mesh:
            radial-gradient(at 12% 15%, rgba(14, 165, 233, 0.22) 0px, transparent 48%),
            radial-gradient(at 88% 12%, rgba(99, 102, 241, 0.20) 0px, transparent 50%),
            radial-gradient(at 50% 88%, rgba(16, 185, 129, 0.14) 0px, transparent 55%),
            linear-gradient(160deg, #030712 0%, #070d1f 55%, #030712 100%);

    /* لایه‌های شیشه مایع (Liquid Glass Surfaces) با کنتراست بالا */
    --glass-surface: rgba(13, 20, 38, 0.72);
    --glass-card: rgba(17, 26, 48, 0.68);
    --glass-card-hover: rgba(24, 36, 66, 0.80);
    --glass-well: rgba(6, 10, 22, 0.82);
    --glass-modal: rgba(12, 19, 36, 0.88);

    /* بازتاب‌های لبه‌ای شیشه اپل (Specular Rim Highlights) */
    --glass-border: rgba(255, 255, 255, 0.14);
    --glass-border-strong: rgba(56, 189, 248, 0.45);
    --glass-specular-top: inset 0 1px 1px 0 rgba(255, 255, 255, 0.32);
    --glass-specular-inner: inset 0 1px 1px 0 rgba(255, 255, 255, 0.26), inset 0 -1px 1px 0 rgba(255, 255, 255, 0.05);
    --glass-shadow: 0 20px 45px -12px rgba(0, 0, 0, 0.7), var(--glass-specular-inner);
    --glass-shadow-sm: 0 10px 28px -8px rgba(0, 0, 0, 0.55), var(--glass-specular-inner);

    /* رنگ‌های نوری و کنتراست متن (WCAG AAA Contrast) */
    --text-main: #ffffff;
    --text-secondary: #e2e8f0;
    --text-sub: #cbd5e1;
    --text-muted: #94a3b8;

    --primary: #38bdf8;
    --primary-bright: #7dd3fc;
    --primary-glow: rgba(56, 189, 248, 0.20);
    --accent: #818cf8;
    --liquid-blue: linear-gradient(135deg, #0ea5e9 0%, #3b82f6 50%, #6366f1 100%);
    --liquid-emerald: linear-gradient(135deg, #10b981 0%, #059669 100%);
    --liquid-rose: linear-gradient(135deg, #f43f5e 0%, #e11d48 100%);
    --liquid-amber: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);

    --success: #34d399;
    --success-bg: rgba(16, 185, 129, 0.20);
    --warning: #fbbf24;
    --warning-bg: rgba(245, 158, 11, 0.22);
    --danger: #fb7185;
    --danger-bg: rgba(244, 63, 94, 0.22);
}

:root[data-theme="light"] {
    --bg-base: #eef2f6;
    --bg-mesh:
            radial-gradient(at 15% 15%, rgba(14, 165, 233, 0.16) 0px, transparent 50%),
            radial-gradient(at 85% 15%, rgba(99, 102, 241, 0.14) 0px, transparent 50%),
            radial-gradient(at 50% 85%, rgba(16, 185, 129, 0.10) 0px, transparent 55%),
            linear-gradient(160deg, #f8fafc 0%, #e2e8f0 100%);

    --glass-surface: rgba(255, 255, 255, 0.78);
    --glass-card: rgba(255, 255, 255, 0.85);
    --glass-card-hover: rgba(255, 255, 255, 0.96);
    --glass-well: rgba(241, 245, 249, 0.92);
    --glass-modal: rgba(255, 255, 255, 0.94);

    --glass-border: rgba(15, 23, 42, 0.12);
    --glass-border-strong: rgba(2, 132, 199, 0.50);
    --glass-specular-inner: inset 0 1px 1px 0 rgba(255, 255, 255, 0.9), inset 0 -1px 1px 0 rgba(15, 23, 42, 0.04);
    --glass-shadow: 0 20px 40px -15px rgba(15, 23, 42, 0.12), var(--glass-specular-inner);
    --glass-shadow-sm: 0 8px 22px -6px rgba(15, 23, 42, 0.08), var(--glass-specular-inner);

    --text-main: #090d16;
    --text-secondary: #1e293b;
    --text-sub: #334155;
    --text-muted: #64748b;

    --primary: #0284c7;
    --primary-bright: #0369a1;
    --primary-glow: rgba(2, 132, 199, 0.14);
    --accent: #4f46e5;
    --liquid-blue: linear-gradient(135deg, #0284c7 0%, #2563eb 55%, #4f46e5 100%);
    --liquid-emerald: linear-gradient(135deg, #059669 0%, #047857 100%);
    --liquid-rose: linear-gradient(135deg, #e11d48 0%, #be123c 100%);
    --liquid-amber: linear-gradient(135deg, #d97706 0%, #b45309 100%);

    --success: #047857;
    --success-bg: rgba(16, 185, 129, 0.16);
    --warning: #b45309;
    --warning-bg: rgba(245, 158, 11, 0.18);
    --danger: #be123c;
    --danger-bg: rgba(244, 63, 94, 0.16);
}

*, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Vazirmatn', -apple-system, BlinkMacSystemFont, 'Segoe UI', Tahoma, sans-serif;
    -webkit-font-smoothing: antialiased;
}

body {
    background-color: var(--bg-base);
    background-image: var(--bg-mesh);
    color: var(--text-main);
    display: flex;
    height: 100vh;
    overflow: hidden;
    position: relative;
}

/* گوی‌های نوری شناور در پس‌زمینه برای شکست نور واقعی در شیشه مایع */
body::before,
body::after {
    content: "";
    position: fixed;
    border-radius: 50%;
    filter: blur(85px);
    z-index: 0;
    pointer-events: none;
    animation: ambientFloat 16s ease-in-out infinite alternate;
}

body::before {
    width: 440px;
    height: 440px;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.18), transparent 70%);
    top: -100px;
    right: 15%;
}

body::after {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.16), transparent 70%);
    bottom: -140px;
    left: 10%;
    animation-delay: -8s;
}

@keyframes ambientFloat {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(-40px, 30px) scale(1.12); }
}

/* ==================== اسکرول‌بار ظریف اپل ==================== */
::-webkit-scrollbar {
    width: 6px;
    height: 6px;
}
::-webkit-scrollbar-track {
    background: transparent;
}
::-webkit-scrollbar-thumb {
    background: rgba(148, 163, 184, 0.3);
    border-radius: 999px;
}
::-webkit-scrollbar-thumb:hover {
    background: var(--primary);
}

/* ==================== انیمیشن‌های سیال ==================== */
@keyframes liquidReveal {
    from {
        opacity: 0;
        transform: translateY(12px) scale(0.99);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

@keyframes pulseGlow {
    0%, 100% {
        box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.6);
        transform: scale(1);
    }
    50% {
        box-shadow: 0 0 0 6px rgba(52, 211, 153, 0);
        transform: scale(1.15);
    }
}

@keyframes highlightFlash {
    0% { box-shadow: 0 0 0 0 rgba(56, 189, 248, 0.85); }
    100% { box-shadow: 0 0 0 14px rgba(56, 189, 248, 0); }
}

.input-flash {
    animation: highlightFlash 0.85s ease-out;
}

/* ==================== نوتیفیکیشن کپسولی (Dynamic Island Toast) ==================== */
#toast-container {
    position: fixed;
    top: 20px;
    left: 24px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 390px;
    pointer-events: none;
}

.toast {
    background: var(--glass-modal);
    backdrop-filter: blur(35px) saturate(200%);
    -webkit-backdrop-filter: blur(35px) saturate(200%);
    border: 1px solid var(--glass-border);
    border-right: 4px solid var(--primary);
    padding: 13px 18px;
    border-radius: 18px;
    box-shadow: var(--glass-shadow);
    color: var(--text-main);
    font-size: 0.86rem;
    font-weight: 600;
    pointer-events: auto;
    animation: liquidReveal 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.toast.toast-error {
    border-right-color: var(--danger);
}

.toast.toast-success {
    border-right-color: var(--success);
}

/* ==================== پنجره ورود شیشه‌ای (Liquid Glass Lock Screen) ==================== */
#auth-overlay {
    position: fixed;
    inset: 0;
    background: radial-gradient(circle at 50% 30%, rgba(14, 165, 233, 0.16), rgba(3, 7, 18, 0.88) 72%);
    backdrop-filter: blur(28px) saturate(180%);
    -webkit-backdrop-filter: blur(28px) saturate(180%);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 5000;
    padding: 20px;
}

.auth-card {
    background: var(--glass-surface);
    backdrop-filter: blur(45px) saturate(200%);
    -webkit-backdrop-filter: blur(45px) saturate(200%);
    border: 1px solid var(--glass-border-strong);
    border-radius: 28px;
    padding: 36px 34px;
    width: 500px;
    max-width: 96vw;
    box-shadow: var(--glass-shadow), 0 0 80px rgba(14, 165, 233, 0.15);
    animation: liquidReveal 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.auth-logo {
    width: 62px;
    height: 62px;
    border-radius: 20px;
    background: var(--liquid-blue);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
    font-size: 1.75rem;
    color: #fff;
    font-weight: 800;
    box-shadow: 0 10px 25px rgba(14, 165, 233, 0.4), inset 0 1px 1px rgba(255, 255, 255, 0.45);
}

.auth-title {
    text-align: center;
    color: var(--text-main);
    font-size: 1.35rem;
    font-weight: 800;
    margin-bottom: 6px;
}

.auth-subtitle {
    text-align: center;
    color: var(--text-sub);
    font-size: 0.82rem;
    margin-bottom: 24px;
}

.auth-error {
    background: var(--danger-bg);
    border: 1px solid var(--danger);
    color: var(--text-main);
    padding: 11px 14px;
    border-radius: 14px;
    font-size: 0.84rem;
    margin-bottom: 16px;
    display: none;
    text-align: center;
    font-weight: 600;
}

.demo-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 12px;
}

.demo-chip {
    background: var(--glass-card);
    border: 1px solid var(--glass-border);
    color: var(--text-main);
    padding: 10px 13px;
    border-radius: 14px;
    font-size: 0.81rem;
    font-weight: 600;
    cursor: pointer;
    text-align: right;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: var(--glass-specular-inner);
    transition: all 0.22s ease;
}

.demo-chip:hover {
    border-color: var(--primary);
    background: var(--primary-glow);
    transform: translateY(-2px);
}

.demo-num {
    background: var(--liquid-blue);
    color: #fff;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 9px;
    font-size: 0.73rem;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35);
}

/* ==================== نوار کناری شناور (iOS 26 Floating Glass Sidebar) ==================== */
aside {
    width: 276px;
    margin: 14px 14px 14px 0;
    border-radius: 24px;
    background: var(--glass-surface);
    backdrop-filter: blur(40px) saturate(200%);
    -webkit-backdrop-filter: blur(40px) saturate(200%);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
    display: flex;
    flex-direction: column;
    z-index: 10;
    flex-shrink: 0;
}

.sidebar-brand {
    padding: 22px 20px;
    border-bottom: 1px solid var(--glass-border);
    display: flex;
    align-items: center;
    gap: 14px;
}

.brand-icon {
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: var(--liquid-blue);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-weight: 800;
    font-size: 1.3rem;
    box-shadow: 0 8px 20px rgba(14, 165, 233, 0.35), inset 0 1px 1px rgba(255, 255, 255, 0.45);
}

.nav-list {
    padding: 16px 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
}

.nav-btn {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 16px;
    padding: 13px 16px;
    text-align: right;
    color: var(--text-sub);
    cursor: pointer;
    width: 100%;
    font-size: 0.9rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 12px;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.nav-btn:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: var(--glass-border);
    color: var(--text-main);
    transform: translateX(-3px);
}

.nav-btn.active {
    background: var(--liquid-blue);
    color: #ffffff;
    font-weight: 700;
    border-color: rgba(255, 255, 255, 0.28);
    box-shadow: 0 10px 24px -4px rgba(14, 165, 233, 0.45), inset 0 1px 1px rgba(255, 255, 255, 0.4);
}

.sidebar-footer {
    padding: 15px 18px;
    border-top: 1px solid var(--glass-border);
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--text-sub);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--success);
    display: inline-block;
    margin-left: 7px;
    animation: pulseGlow 2s infinite;
}

/* ==================== فضای کاری اصلی (Main Workspace) ==================== */
main {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    padding: 14px 20px 18px 20px;
    gap: 16px;
    z-index: 5;
    min-width: 0;
}

header {
    background: var(--glass-surface);
    backdrop-filter: blur(35px) saturate(190%);
    -webkit-backdrop-filter: blur(35px) saturate(190%);
    border: 1px solid var(--glass-border);
    border-radius: 22px;
    padding: 12px 18px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    box-shadow: var(--glass-shadow-sm);
}

.quick-switch-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    background: var(--glass-well);
    padding: 5px 10px;
    border-radius: 14px;
    border: 1px solid var(--glass-border);
}

.qs-btn {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--glass-border);
    color: var(--text-secondary);
    padding: 5px 11px;
    border-radius: 10px;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
}

.qs-btn:hover {
    border-color: var(--primary);
    color: #fff;
    background: var(--liquid-blue);
    transform: translateY(-1px);
}

.header-right {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
}

.role-tag {
    background: var(--primary-glow);
    border: 1px solid var(--glass-border-strong);
    color: var(--primary-bright);
    padding: 5px 13px;
    border-radius: 999px;
    font-size: 0.76rem;
    font-weight: 700;
    box-shadow: var(--glass-specular-top);
}

/* ==================== نوار گام‌های گردش کار (Liquid Stepper) ==================== */
.workflow-stepper {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
}

.step-item {
    background: var(--glass-surface);
    backdrop-filter: blur(28px) saturate(180%);
    -webkit-backdrop-filter: blur(28px) saturate(180%);
    border: 1px solid var(--glass-border);
    border-radius: 18px;
    padding: 13px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    box-shadow: var(--glass-shadow-sm);
    transition: all 0.25s ease;
}

.step-item:hover {
    border-color: var(--glass-border-strong);
    background: var(--glass-card-hover);
    transform: translateY(-2px);
}

.step-num {
    width: 36px;
    height: 36px;
    border-radius: 12px;
    background: var(--liquid-blue);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.95rem;
    flex-shrink: 0;
    box-shadow: 0 6px 14px rgba(14, 165, 233, 0.35), inset 0 1px 1px rgba(255, 255, 255, 0.4);
}

.step-info h5 {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-main);
}

.step-info p {
    font-size: 0.73rem;
    color: var(--text-sub);
    margin-top: 2px;
}

/* ==================== پنل‌ها و کارت‌های شیشه‌ای (Liquid Glass Cards) ==================== */
.section-panel {
    display: none;
    background: var(--glass-surface);
    backdrop-filter: blur(40px) saturate(190%);
    -webkit-backdrop-filter: blur(40px) saturate(190%);
    border: 1px solid var(--glass-border);
    border-radius: 24px;
    padding: 24px;
    box-shadow: var(--glass-shadow);
}

.section-panel.active {
    display: block;
    animation: liquidReveal 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

.sub-box {
    background: var(--glass-card);
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    padding: 20px;
    margin-top: 18px;
    box-shadow: var(--glass-shadow-sm);
    transition: border-color 0.25s ease;
}

.sub-box:hover {
    border-color: rgba(56, 189, 248, 0.3);
}

.sub-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    flex-wrap: wrap;
    gap: 10px;
}

h3 {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text-main);
}

h4 {
    font-size: 0.96rem;
    font-weight: 700;
    color: var(--text-main);
}

/* ==================== فرم‌ها و کپسول یکپارچه استعلام (رفع قطعی باگ اورفلو) ==================== */
.form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    margin-bottom: 16px;
    align-items: end;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-width: 0; /* جلوگیری مطلق از بیرون زدن آیتم‌ها در CSS Grid */
}

label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

input, select, textarea {
    width: 100%;
    min-width: 0;
    background: var(--glass-well);
    border: 1px solid var(--glass-border);
    color: var(--text-main);
    padding: 10px 14px;
    border-radius: 14px;
    outline: none;
    font-size: 0.88rem;
    font-weight: 500;
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.35), 0 1px 0 rgba(255, 255, 255, 0.05);
    transition: all 0.2s ease;
}

input::placeholder, textarea::placeholder {
    color: var(--text-muted);
}

input:focus, select:focus, textarea:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-glow), inset 0 2px 4px rgba(0, 0, 0, 0.35);
}

/* کپسول یکپارچه کد ملی + دکمه استعلام (به سبک آدرس‌بار Safari در iOS 26) */
.liquid-input-group {
    display: flex;
    align-items: center;
    width: 100%;
    min-width: 0;
    background: var(--glass-well);
    border: 1px solid var(--glass-border);
    border-radius: 14px;
    padding: 3px 4px 3px 4px;
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.35);
    transition: all 0.2s ease;
}

.liquid-input-group:focus-within {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-glow), inset 0 2px 4px rgba(0, 0, 0, 0.35);
}

.liquid-input-group input {
    border: none !important;
    background: transparent !important;
    box-shadow: none !important;
    padding: 7px 10px;
    flex: 1;
    min-width: 0;
}

.liquid-input-group .inline-glass-btn {
    flex-shrink: 0;
    background: var(--liquid-blue);
    color: #ffffff;
    border: none;
    padding: 7px 13px;
    border-radius: 10px;
    font-size: 0.76rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(14, 165, 233, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.35);
    transition: all 0.2s ease;
    margin: 0;
}

.liquid-input-group .inline-glass-btn:hover {
    filter: brightness(1.12);
    transform: scale(1.02);
}

/* ==================== دکمه‌های شیشه مایع (Liquid Tactile Buttons) ==================== */
button.action-btn {
    background: var(--liquid-blue);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.24);
    padding: 10px 20px;
    border-radius: 14px;
    font-weight: 700;
    cursor: pointer;
    font-size: 0.86rem;
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 8px 20px -4px rgba(14, 165, 233, 0.4), inset 0 1px 1px rgba(255, 255, 255, 0.4);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
}

button.action-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 26px -4px rgba(14, 165, 233, 0.55), inset 0 1px 1px rgba(255, 255, 255, 0.5);
    filter: brightness(1.08);
}

button.action-btn:active {
    transform: translateY(0) scale(0.98);
}

button.btn-danger {
    background: var(--liquid-rose);
    box-shadow: 0 8px 20px -4px rgba(244, 63, 94, 0.4), inset 0 1px 1px rgba(255, 255, 255, 0.35);
}

button.btn-success {
    background: var(--liquid-emerald);
    box-shadow: 0 8px 20px -4px rgba(16, 185, 129, 0.4), inset 0 1px 1px rgba(255, 255, 255, 0.35);
}

button.btn-secondary {
    background: var(--glass-card);
    color: var(--text-main);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-specular-inner);
}

button.btn-secondary:hover {
    border-color: var(--primary);
    background: var(--primary-glow);
    box-shadow: 0 6px 16px rgba(14, 165, 233, 0.2), var(--glass-specular-inner);
}

button.btn-sm {
    padding: 6px 13px;
    font-size: 0.77rem;
    border-radius: 11px;
    margin-left: 4px;
}

/* ==================== چیپ‌های نسخه آماده ==================== */
.template-chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 16px;
}

.tpl-chip {
    background: var(--primary-glow);
    border: 1px solid var(--glass-border-strong);
    color: var(--text-main);
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 0.77rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: var(--glass-specular-top);
    transition: all 0.2s ease;
}

.tpl-chip:hover {
    background: var(--liquid-blue);
    color: #fff;
    transform: translateY(-2px);
}

/* ==================== کارت‌های شاخص مالی (Liquid KPI Widgets) ==================== */
.kpi-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(175px, 1fr));
    gap: 14px;
    margin-bottom: 18px;
}

.kpi-card {
    background: var(--glass-card);
    backdrop-filter: blur(25px);
    border: 1px solid var(--glass-border);
    border-radius: 18px;
    padding: 16px 18px;
    box-shadow: var(--glass-shadow-sm);
    transition: transform 0.25s ease, border-color 0.25s ease;
}

.kpi-card:hover {
    transform: translateY(-3px);
    border-color: var(--glass-border-strong);
}

.kpi-title {
    font-size: 0.77rem;
    font-weight: 600;
    color: var(--text-sub);
    margin-bottom: 8px;
}

.kpi-value {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-main);
}

.method-bars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 12px;
    margin-top: 12px;
}

.method-bar-item {
    background: var(--glass-well);
    padding: 13px 15px;
    border-radius: 15px;
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-specular-top);
}

.method-bar-top {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-main);
    margin-bottom: 9px;
}

.progress-track {
    height: 8px;
    background: rgba(148, 163, 184, 0.15);
    border-radius: 999px;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    background: var(--liquid-blue);
    width: 0%;
    border-radius: 999px;
    box-shadow: 0 0 12px rgba(56, 189, 248, 0.6);
    transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

/* ==================== جداول و بج‌های شیشه‌ای ==================== */
.table-wrap {
    overflow-x: auto;
    border-radius: 14px;
    border: 1px solid var(--glass-border);
    background: rgba(6, 10, 22, 0.35);
}

table {
    width: 100%;
    border-collapse: collapse;
    text-align: right;
}

th, td {
    padding: 13px 15px;
    border-bottom: 1px solid var(--glass-border);
    font-size: 0.85rem;
    color: var(--text-main);
    vertical-align: middle;
}

th {
    color: var(--text-secondary);
    font-weight: 700;
    font-size: 0.79rem;
    background: rgba(255, 255, 255, 0.04);
}

tbody tr {
    transition: background-color 0.18s ease;
}

tbody tr:hover {
    background-color: var(--primary-glow);
}

.badge {
    padding: 4px 11px;
    border-radius: 999px;
    font-size: 0.73rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    box-shadow: var(--glass-specular-top);
}

.badge-warning {
    background: var(--warning-bg);
    color: var(--warning);
    border: 1px solid rgba(245, 158, 11, 0.45);
}

.badge-success {
    background: var(--success-bg);
    color: var(--success);
    border: 1px solid rgba(16, 185, 129, 0.45);
}

.badge-danger {
    background: var(--danger-bg);
    color: var(--danger);
    border: 1px solid rgba(244, 63, 94, 0.45);
}

.badge-role {
    background: var(--primary-glow);
    color: var(--primary-bright);
    border: 1px solid var(--glass-border-strong);
}

/* ==================== مدال‌های شیشه‌ای ==================== */
.modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(3, 7, 18, 0.76);
    backdrop-filter: blur(18px) saturate(180%);
    -webkit-backdrop-filter: blur(18px) saturate(180%);
    display: none;
    justify-content: center;
    align-items: center;
    z-index: 6000;
    padding: 20px;
}

.modal-card {
    background: var(--glass-modal);
    backdrop-filter: blur(45px) saturate(200%);
    border: 1px solid var(--glass-border-strong);
    border-radius: 24px;
    padding: 26px;
    width: 100%;
    max-width: 650px;
    max-height: 86vh;
    overflow-y: auto;
    box-shadow: var(--glass-shadow);
    animation: liquidReveal 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--glass-border);
    padding-bottom: 14px;
    margin-bottom: 16px;
}

/* ==================== داک ترمینال زنده رخدادها (Apple Liquid Telemetry Dock) ==================== */
.telemetry-dock {
    margin-top: auto;
    background: var(--glass-surface);
    backdrop-filter: blur(40px) saturate(200%);
    -webkit-backdrop-filter: blur(40px) saturate(200%);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    box-shadow: var(--glass-shadow);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
}

.telemetry-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 9px 16px;
    background: rgba(255, 255, 255, 0.04);
    border-bottom: 1px solid var(--glass-border);
}

.telemetry-title-group {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-secondary);
}

.mac-dots {
    display: flex;
    gap: 6px;
    align-items: center;
}

.mac-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
}
.mac-dot.red { background: #ff5f56; box-shadow: 0 0 6px rgba(255, 95, 86, 0.5); }
.mac-dot.yellow { background: #ffbd2e; box-shadow: 0 0 6px rgba(255, 189, 46, 0.5); }
.mac-dot.green { background: #27c93f; box-shadow: 0 0 6px rgba(39, 201, 63, 0.5); }

.telemetry-clear-btn {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--glass-border);
    color: var(--text-sub);
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
}

.telemetry-clear-btn:hover {
    background: var(--primary-glow);
    color: var(--text-main);
    border-color: var(--primary);
}

#console-log {
    padding: 10px 14px;
    min-height: 82px;
    max-height: 120px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.log-line {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 12px;
    border-radius: 11px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 0.81rem;
    font-weight: 500;
    animation: liquidReveal 0.25s ease-out;
}

.log-time-pill {
    font-family: 'Consolas', monospace;
    font-size: 0.73rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 7px;
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-secondary);
    direction: ltr;
    flex-shrink: 0;
}

.log-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
}

.log-ok {
    color: var(--text-main);
    border-right: 3px solid var(--success);
}
.log-ok .log-status-dot {
    background: var(--success);
    box-shadow: 0 0 8px var(--success);
}

.log-err {
    color: #ffe4e6;
    background: rgba(244, 63, 94, 0.12);
    border-color: rgba(244, 63, 94, 0.28);
    border-right: 3px solid var(--danger);
}
.log-err .log-status-dot {
    background: var(--danger);
    box-shadow: 0 0 8px var(--danger);
}
