<file path="src/main/resources/application.properties">
# ==================== Zero-Config LAN/WLAN Server ====================
server.address=0.0.0.0
server.port=${SERVER_PORT:8443}
server.ssl.enabled=${CLINIC_SSL_ENABLED:true}
server.ssl.key-store=file:data/clinic-keystore.p12
server.ssl.key-store-password=ClinicSSL@2026
server.ssl.key-store-type=PKCS12
server.ssl.key-alias=clinic-lan-ssl
server.ssl.enabled-protocols=TLSv1.3,TLSv1.2

server.servlet.encoding.charset=UTF-8
server.servlet.encoding.enabled=true
server.servlet.encoding.force=true
server.tomcat.threads.max=200
server.tomcat.accept-count=100

# ==================== Session & Cookie Security (LAN Compatible) ====================
server.servlet.session.timeout=30m
server.servlet.session.cookie.http-only=true
server.servlet.session.cookie.secure=false
server.servlet.session.cookie.same-site=lax

# ==================== Datasource & HikariCP Concurrency ====================
spring.datasource.url=${CLINIC_DB_URL:jdbc:h2:file:./data/clinic_v4_db;DB_CLOSE_DELAY=-1}
spring.datasource.driverClassName=org.h2.Driver
spring.datasource.username=${CLINIC_DB_USER:sa}
spring.datasource.password=${CLINIC_DB_PASSWORD:}
spring.datasource.hikari.maximum-pool-size=20
spring.datasource.hikari.minimum-idle=5
spring.datasource.hikari.connection-timeout=20000

# ==================== JPA & Hibernate ====================
spring.jpa.database-platform=org.hibernate.dialect.H2Dialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.open-in-view=false

# ==================== H2 Console (Restricted to SUPER_ADMIN) ====================
spring.h2.console.enabled=true
spring.h2.console.path=/h2-console
spring.h2.console.settings.web-allow-others=false

# ==================== Clinic Custom Operational & LAN Flags ====================
clinic.browser.auto-open=${CLINIC_AUTO_OPEN_BROWSER:true}
clinic.security.seed-demo-users=${CLINIC_SEED_DEMO_USERS:true}
clinic.security.reset-existing-passwords=${CLINIC_RESET_PASSWORDS:false}
clinic.security.bootstrap-admin-password=${CLINIC_ADMIN_PASSWORD:Admin@123}
clinic.network.allowed-subnet-prefix=
clinic.audit.lock-timeout-ms=10000
</file>

