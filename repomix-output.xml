            <div class="kpi-card">
                <div class="kpi-title">آخرین هش (Head Hash)</div>
                <div class="kpi-value" id="kpi-last-hash" style="font-family:monospace; font-size:0.86rem;">-</div>
            </div>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                <tr>
                    <th>ردیف</th>
                    <th>زمان ثبت</th>
